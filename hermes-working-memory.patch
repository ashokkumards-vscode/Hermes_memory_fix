@@ -0,0 +1,1060 @@
+"""
+State extraction and working-memory management for WorkingMemoryCompressor.
+
+No Hermes core imports that would create circular dependencies.  Uses
+``agent.auxiliary_client.call_llm`` for one-shot structured LLM calls.
+
+Key design decisions:
+- LLM never writes Markdown files directly; it returns structured JSON patches.
+- Patches are validated and applied deterministically by Python code.
+- Secret filtering runs before any state is persisted.
+- Atomic writes with version history.
+- Significance gate avoids LLM calls on trivial turns.
+- Recursion guard prevents state-update calls from triggering another turn.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import logging
+import os
+import re
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+# ── Secrets / redaction patterns ─────────────────────────────────────────
+# Must be kept in sync with actual credential formats.
+_REDACT_PATTERNS: List[Tuple[re.Pattern, str]] = [
+    # OpenAI / Anthropic / generic API keys
+    (re.compile(r'\b(sk-[A-Za-z0-9]{20,})\b'), 'sk-...REDACTED'),
+    (re.compile(r"""\b(api[-_]?key[-_]?['"]?\s*[:=]\s*['"]?[A-Za-z0-9_-]{20,})""", re.IGNORECASE), 'API_KEY_REDACTED'),
+    # Bearer tokens
+    (re.compile(r'\bBearer\s+[A-Za-z0-9\-._~+/]{20,}', re.IGNORECASE), 'Bearer REDACTED'),
+    # Authorization headers
+    (re.compile(r'\bAuthorization\s*:\s*Basic\s+[A-Za-z0-9+/=]{10,}', re.IGNORECASE), 'Authorization: Basic REDACTED'),
+    (re.compile(r'\bAuthorization\s*:\s*Bearer\s+[A-Za-z0-9\-._~+/]{10,}', re.IGNORECASE), 'Authorization: Bearer REDACTED'),
+    # JWT-like tokens (three base64url segments separated by dots)
+    (re.compile(r'\beyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\b'), 'JWT_REDACTED'),
+    # Password/token/secret assignment patterns
+    (re.compile(r"""\b(password|secret|token|apikey|api_key)\s*[:=]\s*['"]?\S{8,}""", re.IGNORECASE), r'\1: REDACTED'),
+    # Known credential file paths (allow path reference but not content)
+    (re.compile(r'(atlassian-apikey\.json|oauth\.json|auth\.json|\.env)\s*["\']?\s*:\s*["\']?\S{10,}'), r'\1: REDACTED'),
+]
+
+# ── Significance gate heuristics ──────────────────────────────────────────
+# Patterns that indicate a "meaningful" turn worth extracting state from.
+_SIGNIFICANT_PATTERNS: List[re.Pattern] = [
+    re.compile(r'\b(patch|write|create|delete|rename|move|copy|edit|update)\b', re.IGNORECASE),
+    re.compile(r'\b(decided?|decision|choose|select|opt|prefer)\b', re.IGNORECASE),
+    re.compile(r'\b(blocker|blocked|stuck|bug|error|fail|issue|problem)\b', re.IGNORECASE),
+    re.compile(r'\b(fix|fixed|resolve|resolve|workaround|solved|solved)\b', re.IGNORECASE),
+    re.compile(r'\b(architect|design|refactor|restructur|migrate|convert)\b', re.IGNORECASE),
+    re.compile(r'\b(test|tested|verify|validated|confirmed|works|broken)\b', re.IGNORECASE),
+    re.compile(r'\b(goal|objective|task|todo|next|action|plan|step)\b', re.IGNORECASE),
+    re.compile(r'\b(config|deploy|install|setup|migrate|upgrade|downgrade)\b', re.IGNORECASE),
+    re.compile(r'\b(model|provider|api|endpoint|token|auth|credential)\b', re.IGNORECASE),
+    re.compile(r'\b(session|context|engine|compressor|memory|plugin)\b', re.IGNORECASE),
+    re.compile(r'\b(path|file|dir|folder|script|binary|executable)\b', re.IGNORECASE),
+]
+
+# Trivial responses that should never trigger state extraction
+_TRIVIAL_RESPONSE_PATTERNS: List[re.Pattern] = [
+    re.compile(r'^(hello|hi|hey|thanks|thank you|ty|ok|okay|k|sure|yes|no|bye|goodbye|good\s*morning|good\s*afternoon)', re.IGNORECASE),
+    re.compile(r'^(lol|lmao|rofl|nice|great|awesome|perfect|cool)', re.IGNORECASE),
+    re.compile(r'^[0-9+\-*/.=()\s]{1,10}$'),  # simple arithmetic
+]
+
+# ── State extraction prompt template ──────────────────────────────────────
+_STATE_EXTRACTION_PROMPT = """You are a structured state-extraction assistant. Your job is to analyze a conversation turn and produce a JSON patch describing what changed.
+
+Read the conversation turn below. Identify any meaningful state changes relevant to the user's ongoing project or session.
+
+Return ONLY valid JSON matching this schema (no markdown, no explanation):
+
+{{
+  "stable_add": ["long-lived fact 1", "long-lived fact 2"],
+  "stable_resolve": ["exact stable fact text to remove"],
+  "architecture_add": ["architecture decision 1"],
+  "paths_add": ["important file path 1"],
+  "constraints_add": ["explicit user constraint 1"],
+  "constraints_resolve": ["exact constraint text to remove"],
+  "confirmed_working_add": ["verified working 1"],
+  "confirmed_working_resolve": ["exact confirmed-working text to remove"],
+  "blockers_add": ["new blocker 1"],
+  "blockers_resolve": ["exact blocker text to remove"],
+  "decisions_add": ["decision made 1"],
+  "decisions_resolve": ["exact decision text to remove"],
+  "questions_add": ["new open question 1"],
+  "questions_resolve": ["exact question text to remove"],
+  "next_actions_add": ["new next action 1"],
+  "next_actions_remove": ["exact action text to remove"],
+  "recent_changes_add": ["meaningful change 1"],
+  "architecture_add": ["architecture decision 1"],
+  "architecture_resolve": ["exact arch ID"],
+  "paths_add": ["important file path 1"],
+  "paths_resolve": ["exact path ID"],
+  "constraints_add": ["explicit user constraint 1"],
+  "constraints_resolve": ["exact constraint ID"],
+  "confirmed_working_add": ["verified working 1"],
+  "confirmed_working_resolve": ["exact confirmed-working ID"],
+  "blockers_add": ["new blocker 1"],
+  "blockers_resolve": ["exact blocker ID"],
+  "decisions_add": ["decision made 1"],
+  "decisions_resolve": ["exact decision ID"],
+  "provisional_decisions_add": ["provisional decision 1"],
+  "provisional_decisions_resolve": ["exact provisional decision ID"],
+  "questions_add": ["new open question 1"],
+  "questions_resolve": ["exact question ID"],
+  "next_actions_add": ["new next action 1"],
+  "next_actions_remove": ["exact action ID"],
+  "recent_changes_add": ["meaningful change 1"],
+  "current_objective": "active objective for this session",
+  "significance": "high" or "low" or "none"
+}}
+
+CLASSIFICATION RULES:
+- "stable_add": truly permanent facts (project purpose, immutable architecture, owned paths, user's explicit durable rules). Almost nothing belongs here.
+- "constraints_add": explicit user-imposed rules (e.g. "Do not broadcast transactions automatically"). NOT technical limitations.
+- "blockers_add": temporary technical limitations that could be resolved (e.g. "Current API does not expose Task Type").
+- "decisions_add": long-lived decisions that are clearly settled and unlikely to change. These go to stable.md.
+- "provisional_decisions_add": tentative/provisional decisions made during debugging or exploration. These go to state.md and are NOT promoted to stable until confirmed.
+- "confirmed_working_add": features or functionality verified to work.
+- "current_objective": the single active goal the user is working toward right now. Omit if unclear.
+- All resolve fields: use the entry's ID (e.g. "dec-003") to remove it. Do NOT use the full text — IDs are shown in the reference material below.
+
+Rules:
+- "significance": "none" means no meaningful state changes detected. Skip all other fields.
+- "significance": "low" means minor changes (e.g. a single file path, a small clarification).
+- "significance": "high" means major changes (architecture decisions, blockers, new goals).
+- Each entry should be a concise actionable statement (1-2 sentences max).
+- If a decided item already exists, do NOT add it again.
+- Do NOT store: greetings, casual conversation, intermediate reasoning, huge outputs, secrets, passwords, API keys, tokens, credentials.
+- Do NOT duplicate existing state. These are additive patches.
+- Resolve by ID: to remove an existing item, give its ID (e.g. "dec-003"). The ID is shown in brackets at the start of each line in the reference material.
+- If nothing meaningful changed, return {{"significance": "none"}}.
+
+Current stable facts (read-only context for reference):
+---STABLE_START---
+{stable_text}
+---STABLE_END---
+
+Current state (read-only context for reference):
+---STATE_START---
+{state_text}
+---STATE_END---
+
+Conversation turn to analyze:
+---TURN_START---
+{turn_text}
+---TURN_END---
+"""
+
+MAX_TURN_CHARS = 8000  # Truncate turn text to keep prompt affordable
+
+# ── Bootstrap state extraction prompt ──────────────────────────────────────
+# Used for initial population of state.md from full session history.
+# Different from the incremental patch prompt: asks for full operational state.
+_BOOTSTRAP_PROMPT = """You are a structured state-extraction assistant. Your job is to analyze the ENTIRE conversation history of a session and produce a JSON patch describing the current operational state.
+
+Read the full conversation history below. Identify the current objective, confirmed working features, provisional decisions, active blockers, unresolved questions, next actions, and recent meaningful changes.
+
+Return ONLY valid JSON matching this schema (no markdown, no explanation):
+
+{{
+  "current_objective": "single active objective for this session",
+  "confirmed_working_add": ["verified working feature 1", "verified working feature 2"],
+  "provisional_decisions_add": ["provisional/tentative decision 1"],
+  "blockers_add": ["active blocker 1"],
+  "questions_add": ["unresolved question 1"],
+  "next_actions_add": ["next action 1"],
+  "recent_changes_add": ["meaningful change 1"]
+}}
+
+CLASSIFICATION RULES:
+- "current_objective": the single active goal. Omit if unclear.
+- "confirmed_working_add": features or functionality verified to work through testing.
+- "provisional_decisions_add": tentative or provisional decisions made during the session.
+- "blockers_add": current technical limitations or blockers.
+- "questions_add": currently unresolved questions.
+- "next_actions_add": clearly identified next steps.
+- "recent_changes_add": meaningful changes that occurred during this session.
+
+Rules:
+- Each entry should be a concise actionable statement (1-2 sentences max).
+- Do NOT store: greetings, casual conversation, intermediate reasoning, huge outputs, secrets, passwords, API keys, tokens, credentials.
+- Do NOT duplicate. These are additive patches.
+- If the session has no meaningful state, return {{"current_objective": ""}}.
+- Do NOT add entries that are already present in the existing state below.
+
+Existing state (read-only context for reference):
+---STATE_START---
+{state_text}
+---STATE_END---
+
+Full conversation history:
+---HISTORY_START---
+{history_text}
+---HISTORY_END---
+"""
+
+# Maximum history length for bootstrap (chars)
+_BOOTSTRAP_MAX_CHARS = 50000
+
+
+# ── Memory entry ID system ────────────────────────────────────────────────
+# Each markdown bullet is prefixed with a stable ID like [dec-001] so that
+# resolve operations reference the ID rather than depending on exact wording.
+# ID_COUNTERS_FILE stores the next available counter per prefix.
+ID_COUNTERS_FILE = "_ids.json"
+# Prefixes per section (used in markdown formatting and ID generation)
+ID_PREFIX: Dict[str, str] = {
+    "Working Memory": "stable",
+    "Architecture": "arch",
+    "Important Files and Paths": "path",
+    "Explicit User Constraints": "const",
+    "Confirmed Long-Lived Decisions": "dec",
+    "Current Objective": "obj",
+    "Confirmed Working": "cw",
+    "Active Blockers": "blk",
+    "Unresolved Questions": "q",
+    "Next Actions": "act",
+    "Provisional Decisions": "pdec",
+}
+# Regex to extract ID prefix from a markdown item: "[dec-001] content"
+_ID_RE = re.compile(r'^\[([a-z]+-\d+)\]\s*(.*)$')
+# Regex to match the ID part only: "dec-001"
+_ID_PART_RE = re.compile(r'^[a-z]+-\d+$')
+
+# ── Memory budget limits (Phase 3) ────────────────────────────────────────
+STABLE_MAX_TOKENS = 4000   # stable.md target budget
+STATE_MAX_TOKENS = 6000    # state.md target budget
+_BUDGET_WARNED: set = set()  # (session_id, file) pairs already warned
+
+
+# ── Public API ────────────────────────────────────────────────────────────
+
+def is_significant_turn(
+    messages: List[Dict[str, Any]],
+    *,
+    interrupted: bool = False,
+    failed: bool = False,
+) -> Tuple[bool, str]:
+    """Cheap deterministic significance gate.
+
+    Returns (is_significant, reason) tuple.  Skips interrupted/failed turns,
+    trivial responses, and turns with no meaningful content.
+    """
+    # Skip interrupted or failed turns
+    if interrupted:
+        return False, "turn_interrupted"
+    if failed:
+        return False, "turn_failed"
+
+    # Extract the last assistant response text (if any)
+    response_text = ""
+    user_text = ""
+    for msg in reversed(messages):
+        if msg.get("role") == "assistant" and isinstance(msg.get("content"), str):
+            response_text = msg["content"]
+            break
+    for msg in reversed(messages):
+        if msg.get("role") == "user" and isinstance(msg.get("content"), str):
+            user_text = msg["content"]
+            break
+
+    # Check for trivial responses
+    for pat in _TRIVIAL_RESPONSE_PATTERNS:
+        if pat.search(response_text.strip()):
+            return False, "trivial_response"
+
+    # Check for tool_calls in assistant messages (always significant)
+    for msg in messages:
+        if msg.get("role") == "assistant" and msg.get("tool_calls"):
+            return True, "tool_calls_present"
+
+    # Check meaningful patterns in response + user message
+    combined = response_text + " " + user_text
+    for pat in _SIGNIFICANT_PATTERNS:
+        if pat.search(combined):
+            return True, f"pattern_match: {pat.pattern[:40]}"
+
+    return False, "no_significant_patterns"
+
+
+def extract_state_patch(
+    agent: Any,
+    messages: List[Dict[str, Any]],
+    stable_text: str,
+    state_text: str,
+    session_id: str,
+) -> Optional[Dict[str, Any]]:
+    """Call the LLM to extract a structured state patch.
+
+    Uses ``agent.auxiliary_client.call_llm`` which is Hermes's standard
+    auxiliary LLM mechanism (used by compression, vision, etc.).
+
+    Returns the parsed JSON patch dict, or None on failure.
+    """
+    # Build turn text
+    turn_text = _messages_to_text(messages)
+    if len(turn_text) > MAX_TURN_CHARS:
+        turn_text = turn_text[:MAX_TURN_CHARS] + "\n...[truncated]..."
+
+    prompt = _STATE_EXTRACTION_PROMPT.format(
+        stable_text=stable_text or "(none yet)",
+        state_text=state_text or "(none yet)",
+        turn_text=turn_text,
+    )
+
+    try:
+        from agent.auxiliary_client import call_llm
+
+        resp = call_llm(
+            messages=[{"role": "user", "content": prompt}],
+            task="working_memory",
+            max_tokens=2000,
+            temperature=0.1,
+            timeout=60,
+        )
+        body = (
+            resp.choices[0].message.content
+            if hasattr(resp, "choices") and resp.choices
+            else str(resp)
+        ) or ""
+    except Exception as exc:
+        logger.warning(
+            "State extraction LLM call failed (session=%s): %s",
+            session_id, exc,
+        )
+        return None
+
+    # Parse JSON from response (strip markdown fences if present)
+    patch = _parse_json_response(body)
+    if patch is None:
+        logger.debug("State extraction: failed to parse LLM response as JSON")
+        return None
+
+    # Validate structure
+    if not isinstance(patch, dict):
+        logger.debug("State extraction: response is not a dict")
+        return None
+
+    # Check significance
+    sig = patch.get("significance", "none")
+    if sig == "none":
+        return {"significance": "none", "_raw": patch}
+
+    # Normalize all list fields
+    for key in (
+        "stable_add", "stable_resolve", "architecture_add", "architecture_resolve",
+        "paths_add", "paths_resolve",
+        "constraints_add", "constraints_resolve",
+        "confirmed_working_add", "confirmed_working_resolve",
+        "blockers_add", "blockers_resolve",
+        "decisions_add", "decisions_resolve",
+        "provisional_decisions_add", "provisional_decisions_resolve",
+        "questions_add", "questions_resolve",
+        "next_actions_add", "next_actions_remove", "recent_changes_add",
+        "current_objective",
+    ):
+        val = patch.get(key, [])
+        if not isinstance(val, list):
+            patch[key] = []
+        else:
+            patch[key] = [_normalize_entry(str(v)) for v in val if isinstance(v, str)]
+
+    # Redact secrets from patch entries
+    for key in patch:
+        if isinstance(patch[key], list):
+            patch[key] = [_redact_secrets(v) for v in patch[key]]
+        elif isinstance(patch[key], str):
+            patch[key] = _redact_secrets(patch[key])
+
+    return patch
+
+
+
+
+def bootstrap_session_state(
+    session_id: str,
+    session_dir: Path,
+    messages: List[Dict[str, Any]],
+    stable_text: str = "",
+    state_text: str = "",
+) -> bool:
+    """Bootstrap operational state for a session from full conversation history.
+
+    This is a one-time population of state.md sections (Current Objective,
+    Confirmed Working, Provisional Decisions, Active Blockers, Questions,
+    Next Actions, Recent Changes).  It does NOT modify stable.md.
+
+    Uses the existing auxiliary LLM call and deterministic patch machinery.
+    Is idempotent: running it twice without new history will not duplicate state.
+
+    Args:
+        session_id: Hermes session ID (for logging).
+        session_dir: Path to the working-memory directory for this session.
+        messages: Full conversation history as OpenAI-format message dicts.
+        stable_text: Current stable.md content (read-only, not modified).
+        state_text: Current state.md content (will be updated).
+
+    Returns:
+        True if bootstrap produced new state, False otherwise.
+    """
+    # Build history text
+    history_text = _messages_to_text(messages)
+    if len(history_text) > _BOOTSTRAP_MAX_CHARS:
+        # Keep head and tail of the history
+        half = _BOOTSTRAP_MAX_CHARS // 2
+        history_text = (
+            history_text[:half]
+            + "\n\n...[middle of history truncated]...\n\n"
+            + history_text[-half:]
+        )
+
+    prompt = _BOOTSTRAP_PROMPT.format(
+        state_text=state_text or "(empty)",
+        history_text=history_text,
+    )
+
+    try:
+        from agent.auxiliary_client import call_llm
+
+        resp = call_llm(
+            messages=[{"role": "user", "content": prompt}],
+            task="working_memory_bootstrap",
+            max_tokens=2000,
+            temperature=0.1,
+            timeout=120,
+        )
+        body = (
+            resp.choices[0].message.content
+            if hasattr(resp, "choices") and resp.choices
+            else str(resp)
+        ) or ""
+    except Exception as exc:
+        logger.warning(
+            "Bootstrap LLM call failed (session=%s): %s",
+            session_id, exc,
+        )
+        return False
+
+    # Parse JSON
+    patch = _parse_json_response(body)
+    if patch is None:
+        logger.debug("Bootstrap: failed to parse LLM response as JSON")
+        return False
+
+    if not isinstance(patch, dict):
+        logger.debug("Bootstrap: response is not a dict")
+        return False
+
+    # Check if bootstrap produced anything
+    obj = patch.get("current_objective", "")
+    has_content = bool(obj and obj.strip())
+    for key in ("confirmed_working_add", "provisional_decisions_add",
+                "blockers_add", "questions_add", "next_actions_add",
+                "recent_changes_add"):
+        vals = patch.get(key, [])
+        if isinstance(vals, list) and vals:
+            has_content = True
+
+    if not has_content:
+        logger.info("Bootstrap: no meaningful state found for session %s", session_id)
+        return False
+
+    # Force current_objective into the patch
+    if obj and isinstance(obj, str):
+        patch["current_objective"] = obj.strip()
+    else:
+        patch["current_objective"] = ""
+
+    # Normalize and redact (same as extract_state_patch)
+    for key in (
+        "confirmed_working_add", "provisional_decisions_add",
+        "blockers_add", "questions_add", "next_actions_add",
+        "recent_changes_add",
+    ):
+        val = patch.get(key, [])
+        if not isinstance(val, list):
+            patch[key] = []
+        else:
+            patch[key] = [_normalize_entry(str(v)) for v in val if isinstance(v, str)]
+
+    for key in patch:
+        if isinstance(patch[key], list):
+            patch[key] = [_redact_secrets(v) for v in patch[key]]
+        elif isinstance(patch[key], str):
+            patch[key] = _redact_secrets(patch[key])
+
+    # Load ID counters
+    id_counters = load_id_counters(session_dir)
+    prior_counters = dict(id_counters)  # snapshot for rollback
+
+    # Apply patch to state.md only (stable.md is NOT modified)
+    # The patch routes through apply_state_patch which naturally avoids
+    # stable.md changes because we don't set any stable_add/decisions_add keys.
+    # We explicitly set decisions_add=[] to prevent cross-file promotion.
+    patch["decisions_add"] = []
+    patch["stable_add"] = []
+    patch["architecture_add"] = []
+    patch["paths_add"] = []
+    patch["constraints_add"] = []
+
+    new_stable, new_state = apply_state_patch(
+        patch, stable_text, state_text,
+        id_counters=id_counters,
+        session_dir=session_dir,
+    )
+
+    # Check if state actually changed
+    if new_state == state_text:
+        logger.info("Bootstrap: no changes needed (session=%s)", session_id)
+        return False
+
+    # Write files atomically
+    ok = write_state_files(
+        session_dir, new_stable, new_state,
+        max_versions=10, session_id=session_id,
+    )
+    if ok:
+        logger.info(
+            "Bootstrap: state populated for session %s (objective=%s, entries=%d)",
+            session_id, patch.get("current_objective", "")[:60],
+            sum(len(v) for v in patch.values() if isinstance(v, list)),
+        )
+        return True
+    else:
+        logger.warning("Bootstrap: file write failed (session=%s)", session_id)
+        # Rollback ID counters
+        save_id_counters(session_dir, prior_counters)
+        return False
+
+def apply_state_patch(
+    patch: Dict[str, Any],
+    stable_text: str,
+    state_text: str,
+    *,
+    id_counters: Optional[Dict[str, int]] = None,
+    session_dir: Optional[Path] = None,
+) -> Tuple[str, str]:
+    """Apply a validated patch to stable and state text.
+
+    Returns (new_stable, new_state) as Markdown strings.
+    Never modifies input strings in place.
+    """
+    # Parse existing state
+    stable_sections = _parse_markdown_sections(stable_text)
+    state_sections = _parse_markdown_sections(state_text)
+
+    # ── Stable sections (with resolve support) ──
+    if "Working Memory" not in stable_sections:
+        stable_sections["Working Memory"] = []
+    stable_sections["Working Memory"] = _apply_add_remove(
+        stable_sections["Working Memory"],
+        patch.get("stable_add", []),
+        patch.get("stable_resolve", []),
+        id_counters=id_counters,
+        section_name="Working Memory",
+    )
+    # Sub-sections of stable (with resolve support for all sections)
+    for section_key, add_key, remove_key in [
+        ("Architecture", "architecture_add", "architecture_resolve"),
+        ("Important Files and Paths", "paths_add", "paths_resolve"),
+        ("Explicit User Constraints", "constraints_add", "constraints_resolve"),
+        ("Confirmed Long-Lived Decisions", "decisions_add", "decisions_resolve"),
+    ]:
+        if section_key not in stable_sections:
+            stable_sections[section_key] = []
+        stable_sections[section_key] = _apply_add_remove(
+            stable_sections[section_key],
+            patch.get(add_key, []),
+            patch.get(remove_key, []) if remove_key else [],
+            id_counters=id_counters,
+            section_name=section_key,
+        )
+
+    # ── State sections (OWNERSHIP: decisions go to stable.md only) ──
+    # decisions_add is ONLY routed to stable.md "Confirmed Long-Lived Decisions"
+    # to prevent cross-file duplication. State.md has no "Decisions Made" section.
+    for section_key, add_key, remove_key in [
+        ("Confirmed Working", "confirmed_working_add", "confirmed_working_resolve"),
+        ("Provisional Decisions", "provisional_decisions_add", "provisional_decisions_resolve"),
+        ("Active Blockers", "blockers_add", "blockers_resolve"),
+        ("Unresolved Questions", "questions_add", "questions_resolve"),
+        ("Next Actions", "next_actions_add", "next_actions_remove"),
+    ]:
+        if section_key not in state_sections:
+            state_sections[section_key] = []
+        state_sections[section_key] = _apply_add_remove(
+            state_sections[section_key],
+            patch.get(add_key, []),
+            patch.get(remove_key, []),
+            id_counters=id_counters,
+            section_name=section_key,
+        )
+
+    # Current Objective: single string, not a list
+    if "current_objective" in patch and isinstance(patch["current_objective"], str):
+        obj = patch["current_objective"].strip()
+        if obj:
+            state_sections["Current Objective"] = [obj]
+
+    # Recent changes: append-only, capped at 20
+    if "Recent Meaningful Changes" not in state_sections:
+        state_sections["Recent Meaningful Changes"] = []
+    changes = state_sections["Recent Meaningful Changes"]
+    changes.extend(patch.get("recent_changes_add", []))
+    # Deduplicate
+    seen = set()
+    unique_changes = []
+    for c in reversed(changes):
+        key = c.strip().lower()
+        if key not in seen:
+            seen.add(key)
+            unique_changes.append(c)
+    state_sections["Recent Meaningful Changes"] = list(reversed(unique_changes))[:20]
+
+    # ── Rebuild Markdown ──
+    new_stable = _rebuild_stable_markdown(stable_sections)
+    new_state = _rebuild_state_markdown(state_sections)
+
+    return new_stable, new_state
+
+
+def write_state_files(
+    session_dir: Path,
+    stable_text: str,
+    state_text: str,
+    *,
+    timestamp: Optional[str] = None,
+    max_versions: int = 10,
+    session_id: str = "",
+) -> bool:
+    """Atomically write state files with version history.
+
+    Saves previous versions under ``versions/`` subdirectory.
+    Returns True on success, False on failure.
+    """
+    if timestamp is None:
+        timestamp = time.strftime("%Y%m%dT%H%M%S", time.gmtime())
+
+    try:
+        versions_dir = session_dir / "versions"
+        versions_dir.mkdir(parents=True, exist_ok=True)
+
+        # Save previous versions before overwriting
+        for fname in (STABLE_FILE := "stable.md", STATE_FILE := "state.md"):
+            src = session_dir / fname
+            if src.exists():
+                import shutil
+                dst = versions_dir / f"{fname.replace('.md', '')}-{timestamp}.md"
+                shutil.copy2(src, dst)
+
+        # Atomic writes: write to temp, rename into place
+        _atomic_write(session_dir / STABLE_FILE, stable_text)
+        _atomic_write(session_dir / STATE_FILE, state_text)
+
+        # Clean up old versions
+        _cleanup_old_versions(versions_dir, max_versions)
+
+        # Persist ID counters
+        _counters = load_id_counters(session_dir)
+        if _counters:
+            save_id_counters(session_dir, _counters)
+
+        # Budget check (shadow mode: log only, no truncation)
+        from agent.model_metadata import estimate_tokens_rough
+        stable_tok = estimate_tokens_rough(stable_text)
+        state_tok = estimate_tokens_rough(state_text)
+        _key = f"{session_id}"
+        if stable_tok > STABLE_MAX_TOKENS and _key + ":stable" not in _BUDGET_WARNED:
+            logger.warning("stable.md ~%d tokens exceeds %d budget (session=%s)", stable_tok, STABLE_MAX_TOKENS, session_id)
+            _BUDGET_WARNED.add(_key + ":stable")
+        if state_tok > STATE_MAX_TOKENS and _key + ":state" not in _BUDGET_WARNED:
+            logger.warning("state.md ~%d tokens exceeds %d budget (session=%s)", state_tok, STATE_MAX_TOKENS, session_id)
+            _BUDGET_WARNED.add(_key + ":state")
+        return True
+    except OSError as exc:
+        logger.warning("Failed to write state files: %s", exc)
+        return False
+
+
+def load_state_files(session_dir: Path) -> Tuple[str, str]:
+    """Load current stable and state text. Returns empty strings on failure."""
+    stable = ""
+    state = ""
+    try:
+        sp = session_dir / "stable.md"
+        if sp.exists():
+            stable = sp.read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        pass
+    try:
+        sp = session_dir / "state.md"
+        if sp.exists():
+            state = sp.read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        pass
+    # Run migration on existing entries (idempotent)
+    try:
+        migrate_existing_entries(session_dir)
+        # Reload after migration
+        try:
+            sp = session_dir / "stable.md"
+            if sp.exists():
+                stable = sp.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            pass
+        try:
+            sp = session_dir / "state.md"
+            if sp.exists():
+                state = sp.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            pass
+    except Exception as exc:
+        logger.debug("Migration failed: %s", exc)
+    return stable, state
+
+
+# ── Internal helpers ──────────────────────────────────────────────────────
+
+_RECURSION_GUARD_ATTR = "_wm_updating_state"
+
+
+def set_updating_flag(agent: Any) -> bool:
+    """Atomically check and set the recursion guard flag.
+
+    Returns True if the flag was already set (re-entrant call detected).
+    Returns False if we acquired the flag (safe to proceed).
+    """
+    if getattr(agent, _RECURSION_GUARD_ATTR, False):
+        return True  # Already in a state update
+    setattr(agent, _RECURSION_GUARD_ATTR, True)
+    return False
+
+
+def clear_updating_flag(agent: Any) -> None:
+    """Clear the recursion guard flag."""
+    setattr(agent, _RECURSION_GUARD_ATTR, False)
+
+
+def _messages_to_text(messages: List[Dict[str, Any]]) -> str:
+    """Convert messages to a flat text representation for the LLM."""
+    parts = []
+    for msg in messages:
+        role = msg.get("role", "?")
+        content = msg.get("content", "")
+        if isinstance(content, list):
+            text_parts = []
+            for part in content:
+                if isinstance(part, dict) and part.get("type") == "text":
+                    text_parts.append(part.get("text", ""))
+            content = " ".join(text_parts)
+        if not isinstance(content, str):
+            content = str(content)
+        # Truncate very long tool results
+        if len(content) > 2000:
+            content = content[:2000] + f"\n...[+{len(content)-2000} chars truncated]..."
+        # Include tool call info
+        tool_calls = msg.get("tool_calls")
+        if tool_calls:
+            content += "\n[TOOL_CALLS: " + str(len(tool_calls)) + "]"
+        parts.append(f"[{role}]: {content}")
+    return "\n\n".join(parts)
+
+
+def _parse_json_response(text: str) -> Optional[Dict[str, Any]]:
+    """Parse JSON from LLM response, stripping markdown fences if needed."""
+    text = text.strip()
+    # Remove markdown code fences
+    if text.startswith("```"):
+        # Find the first newline after ```
+        first_nl = text.find("\n")
+        if first_nl != -1:
+            text = text[first_nl:].strip()
+        # Remove trailing ```
+        if text.endswith("```"):
+            text = text[:-3].strip()
+        elif text.endswith("```\n"):
+            text = text[:-4].strip()
+    try:
+        return json.loads(text)
+    except json.JSONDecodeError:
+        # Try to find JSON in the text
+        brace_start = text.find("{")
+        brace_end = text.rfind("}")
+        if brace_start != -1 and brace_end > brace_start:
+            try:
+                return json.loads(text[brace_start:brace_end + 1])
+            except json.JSONDecodeError:
+                pass
+        return None
+
+
+def _normalize_entry(text: str) -> str:
+    """Normalize whitespace and case for deterministic dedup."""
+    text = re.sub(r'\s+', ' ', text).strip()
+    return text
+
+
+
+def _redact_secrets(text: str) -> str:
+    """Redact likely secrets from text."""
+    result = text
+    for pattern, replacement in _REDACT_PATTERNS:
+        result = pattern.sub(replacement, result)
+    return result
+
+def _strip_id(item: str) -> Tuple[Optional[str], str]:
+    """Extract the ID prefix from a markdown list item.
+
+    Returns (id, text_without_id).  If no ID prefix is found,
+    returns (None, item).
+    """
+    m = _ID_RE.match(item)
+    if m:
+        return m.group(1), m.group(2).strip()
+    return None, item
+
+
+def _get_next_id_counter(counters: Dict[str, int], prefix: str) -> int:
+    """Return the next available counter for a prefix, starting at 1."""
+    return counters.get(prefix, 0) + 1
+
+
+def _set_next_id_counter(counters: Dict[str, int], prefix: str, value: int) -> None:
+    """Set the next counter value for a prefix."""
+    counters[prefix] = value
+
+
+def load_id_counters(session_dir: Path) -> Dict[str, int]:
+    """Load the ID counter state from the session directory."""
+    try:
+        p = session_dir / ID_COUNTERS_FILE
+        if p.exists():
+            with p.open() as f:
+                return json.load(f)
+    except (OSError, json.JSONDecodeError):
+        pass
+    return {}
+
+
+def save_id_counters(session_dir: Path, counters: Dict[str, int]) -> None:
+    """Atomically save the ID counter state."""
+    try:
+        _atomic_write(session_dir / ID_COUNTERS_FILE, json.dumps(counters, indent=2))
+    except OSError as exc:
+        logger.debug("Failed to save ID counters: %s", exc)
+
+
+def migrate_existing_entries(session_dir: Path) -> None:
+    """Migrate existing state files to add ID prefixes to entries.
+
+    Reads stable.md and state.md, assigns IDs to any entries that lack them,
+    and writes the result back atomically.  Safe to call multiple times
+    (idempotent — entries already with IDs are skipped).
+    """
+    counters = load_id_counters(session_dir)
+    changed = False
+
+    for fname in ("stable.md", "state.md"):
+        fpath = session_dir / fname
+        if not fpath.exists():
+            continue
+        text = fpath.read_text(encoding="utf-8", errors="replace")
+        sections = _parse_markdown_sections(text)
+        for section_name, items in sections.items():
+            if section_name.startswith("_"):
+                continue
+            prefix = ID_PREFIX.get(section_name, "")
+            if not prefix:
+                continue
+            new_items = []
+            for item in items:
+                item_id, item_text = _strip_id(item)
+                if item_id:
+                    new_items.append(item)
+                else:
+                    n = _get_next_id_counter(counters, prefix)
+                    _set_next_id_counter(counters, prefix, n + 1)
+                    new_items.append(f"[{prefix}-{n:03d}] {item_text}")
+                    changed = True
+            sections[section_name] = new_items
+
+        if not changed:
+            continue
+        if fname == "stable.md":
+            new_text = _rebuild_stable_markdown(sections)
+        else:
+            new_text = _rebuild_state_markdown(sections)
+        _atomic_write(fpath, new_text)
+
+    if changed:
+        save_id_counters(session_dir, counters)
+        logger.info("Migrated existing entries: assigned IDs in %s", session_dir)
+
+
+def _parse_markdown_sections(md_text: str) -> Dict[str, List[str]]:
+    """Parse markdown into a dict of section -> list of bullet items.
+
+    Each item is stored as its raw markdown text (including ID prefix if present).
+    The ID prefix is extracted by ``_strip_id()`` at compare time.
+    """
+    sections: Dict[str, List[str]] = {}
+    current_section = "_header"
+    sections[current_section] = []
+
+    for line in md_text.split("\n"):
+        if line.startswith("#"):
+            heading = line.lstrip("#").strip()
+            current_section = heading
+            if current_section not in sections:
+                sections[current_section] = []
+        elif line.strip().startswith("- ") or line.strip().startswith("* "):
+            item = line.strip()[2:].strip()
+            if item:
+                sections.setdefault(current_section, []).append(item)
+        elif line.strip().startswith("1.") or line.strip().startswith("2."):
+            item = re.sub(r'^\d+\.\s*', '', line.strip()).strip()
+            if item:
+                sections.setdefault(current_section, []).append(item)
+
+    return sections
+
+
+def _apply_add_remove(
+    existing: List[str],
+    adds: List[str],
+    removes: List[str],
+    *,
+    id_counters: Optional[Dict[str, int]] = None,
+    section_name: str = "",
+) -> List[str]:
+    """Apply additive and removal patches to a list of items.
+
+    Resolution uses ID matching (primary) or normalized text (fallback).
+    New items get an auto-assigned ID prefix like ``[dec-003]``.
+    Assigns IDs using ``id_counters`` (mutated in place).  When
+    ``id_counters`` is None, IDs are not added (backward-compat path).
+    """
+    # Build a lookup: ID -> raw item, normalized -> raw item
+    id_map: Dict[str, str] = {}   # "dec-003" -> "[dec-003] content"
+    norm_map: Dict[str, str] = {} # "content" -> "[dec-003] content"
+
+    for item in existing:
+        item_id, item_text = _strip_id(item)
+        if item_id:
+            id_map[item_id] = item
+        norm_map[_normalize_entry(item_text or item)] = item
+
+    # ── Resolve: try ID first, then normalized text ───────────────
+    for remove in removes:
+        remove = remove.strip()
+        # Check if remove is an ID reference
+        if _ID_PART_RE.match(remove):
+            removed = id_map.pop(remove, None)
+            if removed is not None:
+                norm_key = _normalize_entry(_strip_id(removed)[1] or removed)
+                norm_map.pop(norm_key, None)
+                continue
+        # Fallback: normalized text match
+        norm_remove = _normalize_entry(remove)
+        removed_item = norm_map.pop(norm_remove, None)
+        if removed_item is not None:
+            r_id = _strip_id(removed_item)[0]
+            if r_id:
+                id_map.pop(r_id, None)
+
+    # ── Add new items ─────────────────────────────────────────────
+    prefix = ID_PREFIX.get(section_name, "")
+    next_counter = _get_next_id_counter(id_counters, prefix) if id_counters and prefix else 0
+
+    for add in adds:
+        add = add.strip()
+        if not add:
+            continue
+        norm_add = _normalize_entry(add)
+        # Skip if already exists (by normalized text)
+        if norm_add in norm_map:
+            continue
+        # Assign ID
+        if prefix and id_counters is not None:
+            n = _get_next_id_counter(id_counters, prefix)
+            _set_next_id_counter(id_counters, prefix, n + 1)
+            item = f"[{prefix}-{n:03d}] {add}"
+        else:
+            item = add
+        norm_map[norm_add] = item
+        entry_id = _strip_id(item)[0]
+        if entry_id:
+            id_map[entry_id] = item
+
+    return list(norm_map.values())
+
+
+def _rebuild_stable_markdown(sections: Dict[str, List[str]]) -> str:
+    """Rebuild stable.md from section dict."""
+    lines = ["# Stable Working Memory\n"]
+    section_order = [
+        "Working Memory",
+        "Architecture",
+        "Important Files and Paths",
+        "Explicit User Constraints",
+        "Confirmed Long-Lived Decisions",
+    ]
+    for sec in section_order:
+        items = sections.get(sec, [])
+        if items:
+            label = sec.replace("-", " / ").replace("_", " ")
+            lines.append(f"\n## {label}\n")
+            for item in items:
+                lines.append(f"- {item}\n")
+    return "".join(lines)
+
+
+def _rebuild_state_markdown(sections: Dict[str, List[str]]) -> str:
+    """Rebuild state.md from section dict."""
+    lines = ["# Current Working State\n"]
+    section_order = [
+        "Current Objective",
+        "Confirmed Working",
+        "Provisional Decisions",
+        "Active Blockers",
+        "Unresolved Questions",
+        "Next Actions",
+        "Recent Meaningful Changes",
+    ]
+    # Start with Current Objective if present
+    for sec in section_order:
+        items = sections.get(sec, [])
+        if sec == "Current Objective" and not items:
+            continue
+        label = sec.replace("-", " / ").replace("_", " ")
+        lines.append(f"\n## {label}\n")
+        for item in items:
+            lines.append(f"- {item}\n")
+    return "".join(lines)
+
+
+def _atomic_write(path: Path, content: str) -> None:
+    """Write content atomically to a file."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(path.suffix + ".tmp")
+    tmp.write_text(content, encoding="utf-8")
+    tmp.replace(path)
+
+
+def _cleanup_old_versions(versions_dir: Path, max_versions: int) -> None:
+    """Remove oldest version files beyond the cap."""
+    try:
+        files = sorted(versions_dir.iterdir(), key=lambda p: p.stat().st_mtime)
+        while len(files) > max_versions:
+            oldest = files.pop(0)
+            oldest.unlink(missing_ok=True)
+    except OSError:
+        pass

