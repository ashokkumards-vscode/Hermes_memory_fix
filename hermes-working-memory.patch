+"""
+Working-Memory Context Engine — Phase 3: controlled real-context A/B test.
+
+Extends the built-in ContextCompressor with a ``select_context()`` override
+that, for Telegram sessions, can build a compact-context proposal.
+
+Modes:
+  shadow (default)  — select_context() returns None (Hermes sends full context)
+  active            — select_context() returns compact context for allowlisted
+                      sessions; all others return None
+
+Inherits ALL compression behavior (summarisation, pruning, cooldowns,
+telemetry) from ContextCompressor.  Rollback is a single config change:
+
+    # config.yaml
+    context.engine: compressor   (was: working-memory)
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+from agent.context_compressor import ContextCompressor
+from agent.model_metadata import estimate_messages_tokens_rough, estimate_tokens_rough
+
+logger = logging.getLogger(__name__)
+
+# ── Configuration constants ────────────────────────────────────────────────
+# ENABLED_PLATFORMS removed -- replaced by _ACTIVE_PLATFORMS / _EXCLUDED_PLATFORMS / _ACTIVE_SESSIONS
+RECENT_MESSAGES = 20
+RECENT_RAW_TOKEN_TARGET = 30000
+WORKING_MEMORY_BASE = Path.home() / ".hermes" / "context-working-memory"
+STATE_DIR = WORKING_MEMORY_BASE
+CONFIG_FILE = WORKING_MEMORY_BASE / "phase3_config.yaml"
+STABLE_FILE = "stable.md"
+STATE_FILE = "state.md"
+SHADOW_LOG = "shadow.jsonl"
+MAX_VERSIONS = 10
+
+# Default config values (overridden by phase3_config.yaml)
+_MODE = "shadow"
+_MIN_SAVINGS_PCT = 25
+_MAX_COMPACT_TOKENS = 100000
+_ACTIVE_SESSIONS: List[str] = []
+_ACTIVE_PLATFORMS: set = set()
+_EXCLUDED_PLATFORMS: set = set()
+_EXCLUDED_SESSIONS: set = set()
+_MIN_ORIGINAL_TOKENS = 50000
+_CONFIG_LOADED = False
+
+
+def _load_config(*, force: bool = False) -> None:
+    """Load Phase 3 configuration from YAML file (idempotent unless force=True)."""
+    global _MODE, _MIN_SAVINGS_PCT, _MAX_COMPACT_TOKENS, _ACTIVE_SESSIONS, _CONFIG_LOADED
+    global _ACTIVE_PLATFORMS, _EXCLUDED_PLATFORMS, _EXCLUDED_SESSIONS, _MIN_ORIGINAL_TOKENS
+    if _CONFIG_LOADED and not force:
+        return
+    _CONFIG_LOADED = True
+    try:
+        import yaml
+        if CONFIG_FILE.exists():
+            with open(CONFIG_FILE, "r") as f:
+                cfg = yaml.safe_load(f) or {}
+            _MODE = str(cfg.get("mode", "shadow")).strip().lower()
+            _MIN_SAVINGS_PCT = int(cfg.get("min_savings_pct", 25))
+            _MAX_COMPACT_TOKENS = int(cfg.get("max_compact_tokens", 100000))
+            _MIN_ORIGINAL_TOKENS = int(cfg.get("min_original_tokens", 50000))
+            _ACTIVE_SESSIONS = list(cfg.get("active_sessions", []))
+            _ACTIVE_PLATFORMS = set(cfg.get("active_platforms", []))
+            _EXCLUDED_PLATFORMS = set(cfg.get("excluded_platforms", []))
+            _EXCLUDED_SESSIONS = set(cfg.get("excluded_sessions", []))
+            logger.info(
+                "Working-memory: mode=%s, active_platforms=%s, active_sessions=%d, excluded_platforms=%s, excluded_sessions=%d",
+                _MODE, sorted(_ACTIVE_PLATFORMS), len(_ACTIVE_SESSIONS),
+                sorted(_EXCLUDED_PLATFORMS), len(_EXCLUDED_SESSIONS),
+            )
+    except Exception as exc:
+        logger.debug("Failed to load phase3 config: %s", exc)
+
+
+# ── register() for Hermes plugin discovery ─────────────────────────────────
+def register(ctx):
+    """Hermes context-engine plugin registration entrypoint."""
+    _load_config()
+    engine = WorkingMemoryCompressor()
+    ctx.register_context_engine(engine)
+
+
+# ── The engine ─────────────────────────────────────────────────────────────
+class WorkingMemoryCompressor(ContextCompressor):
+    """Context engine with working-memory state and compact context selection.
+
+    Preserves every inherited compression behaviour.  ``select_context()``
+    and lifecycle hooks are overridden to add compact-context selection
+    (shadow or active depending on config) and state extraction.
+    """
+
+    def __init__(self):
+        _load_config()
+        super().__init__(
+            model="",
+            threshold_percent=0.75,
+            protect_first_n=3,
+            protect_last_n=20,
+            summary_target_ratio=0.20,
+        )
+        # Working-memory state (all set during on_session_start)
+        self._session_platform: str = ""
+        self._session_id: str = ""
+        self._session_dir: Optional[Path] = None
+        self._shadow_log_path: Optional[Path] = None
+        self._stable_path: Optional[Path] = None
+        self._state_path: Optional[Path] = None
+        self._shadow_turn: int = 0
+        # State version tracking
+        self._state_version: int = 0
+        # Shadow metrics for state extraction
+        self._last_state_significance: str = ""
+        self._last_state_attempted: bool = False
+        self._last_state_applied: bool = False
+        self._last_state_skip_reason: str = ""
+        self._last_state_error: str = ""
+        self._last_state_patch_counts: str = ""
+
+    # ── Identity ───────────────────────────────────────────────────────────
+
+    @property
+    def name(self) -> str:
+        return "working-memory"
+
+    # ── Lifecycle hooks (all call super()) ─────────────────────────────────
+
+    def on_session_start(self, session_id: str, **kwargs) -> None:
+        """Attach to a new or resumed session."""
+        super().on_session_start(session_id, **kwargs)
+        self._session_id = session_id
+        self._session_platform = kwargs.get("platform", "") or ""
+        self._shadow_turn = 0
+        self._state_version = 0
+
+        if self._is_shadow_eligible():
+            self._ensure_session_dir()
+        else:
+            self._session_dir = None
+            self._shadow_log_path = None
+
+    def on_session_reset(self) -> None:
+        """Reset per-session state."""
+        super().on_session_reset()
+        self._session_platform = ""
+        self._session_id = ""
+        self._session_dir = None
+        self._shadow_log_path = None
+        self._stable_path = None
+        self._state_path = None
+        self._shadow_turn = 0
+        self._state_version = 0
+
+    def on_session_end(self, session_id: str, messages: List[Dict[str, Any]]) -> None:
+        """Tear-down at real session boundaries."""
+        super().on_session_end(session_id, messages)
+        self._session_id = ""
+        self._shadow_turn = 0
+
+    # ── on_turn_complete — state extraction (unchanged from Phase 2.1) ────
+
+    def on_turn_complete(
+        self,
+        messages: List[Dict[str, Any]],
+        usage: Dict[str, Any] = None,
+        **kwargs: Any,
+    ) -> None:
+        """Post-turn observation: update working-memory state if meaningful."""
+        self._last_state_significance = ""
+        self._last_state_attempted = False
+        self._last_state_applied = False
+        self._last_state_skip_reason = ""
+        self._last_state_error = ""
+        self._last_state_patch_counts = ""
+
+        if not self._is_shadow_eligible():
+            self._last_state_skip_reason = "not_eligible"
+            return
+
+        interrupted = kwargs.get("interrupted", False)
+        failed = kwargs.get("failed", False)
+
+        # Import state extractor lazily
+        is_significant_turn = None
+        extract_state_patch = None
+        apply_state_patch = None
+        write_state_files = None
+        load_state_files = None
+        set_updating_flag = None
+        clear_updating_flag = None
+        try:
+            import importlib.util
+            _engine_dir = Path(__file__).parent
+            _extractor_path = _engine_dir / "state_extractor.py"
+            if _extractor_path.exists():
+                _spec = importlib.util.spec_from_file_location(
+                    "working_memory_extractor", str(_extractor_path),
+                )
+                _mod = importlib.util.module_from_spec(_spec)
+                _spec.loader.exec_module(_mod)
+                is_significant_turn = _mod.is_significant_turn
+                extract_state_patch = _mod.extract_state_patch
+                apply_state_patch = _mod.apply_state_patch
+                write_state_files = _mod.write_state_files
+                load_state_files = _mod.load_state_files
+                set_updating_flag = _mod.set_updating_flag
+                clear_updating_flag = _mod.clear_updating_flag
+                load_id_counters = _mod.load_id_counters
+        except Exception as exc:
+            logger.debug("State extractor not available: %s", exc)
+            return
+
+        if None in (is_significant_turn, extract_state_patch, apply_state_patch,
+                    write_state_files, load_state_files, set_updating_flag,
+                    clear_updating_flag):
+            return
+
+        if set_updating_flag(self):
+            self._last_state_skip_reason = "recursion_guard"
+            return
+
+        try:
+            significant, reason = is_significant_turn(
+                messages, interrupted=interrupted, failed=failed,
+            )
+            self._last_state_significance = reason
+            if not significant:
+                self._last_state_skip_reason = reason
+                return
+
+            self._last_state_attempted = True
+            stable_text, state_text = "", ""
+            if self._session_dir is not None:
+                stable_text, state_text = load_state_files(self._session_dir)
+
+            patch = extract_state_patch(
+                self, messages, stable_text, state_text, self._session_id,
+            )
+            if patch is None:
+                self._last_state_error = "extraction_failed"
+                return
+
+            sig = patch.get("significance", "none")
+            if sig == "none":
+                self._last_state_skip_reason = "llm_significance_none"
+                return
+
+            counts = {}
+            for key in (
+                "stable_add", "stable_resolve", "architecture_add", "architecture_resolve",
+                "paths_add", "paths_resolve", "constraints_add", "constraints_resolve",
+                "confirmed_working_add", "confirmed_working_resolve",
+                "blockers_add", "blockers_resolve",
+                "decisions_add", "decisions_resolve",
+                "provisional_decisions_add", "provisional_decisions_resolve",
+                "questions_add", "questions_resolve",
+                "next_actions_add", "next_actions_remove", "recent_changes_add",
+                "current_objective",
+            ):
+                val = patch.get(key, [])
+                if isinstance(val, list) and val:
+                    counts[key] = len(val)
+            self._last_state_patch_counts = json.dumps(counts, sort_keys=True)
+
+            _idc = load_id_counters(self._session_dir) if self._session_dir is not None else None
+            new_stable, new_state = apply_state_patch(
+                patch, stable_text, state_text,
+                id_counters=_idc, session_dir=self._session_dir,
+            )
+            if self._session_dir is not None:
+                ok = write_state_files(
+                    self._session_dir, new_stable, new_state,
+                    max_versions=MAX_VERSIONS, session_id=self._session_id,
+                )
+                if ok:
+                    self._state_version += 1
+                    self._last_state_applied = True
+                else:
+                    self._last_state_error = "file_write_failed"
+        except Exception as exc:
+            logger.warning("State update failed (session=%s): %s", self._session_id, exc)
+            self._last_state_error = str(exc)[:200]
+        finally:
+            clear_updating_flag(self)
+
+    # ── bootstrap_session_state — one-time population of state.md ────────
+
+    def bootstrap_session_state(self) -> bool:
+        """Bootstrap operational state for the current session.
+
+        Reads the full conversation history from Hermes SessionDB, derives
+        operational state via the LLM, and populates state.md only.
+
+        Returns True if state was populated, False otherwise.
+        Callable explicitly — does NOT run automatically.
+        """
+        if not self._session_dir:
+            logger.warning("Bootstrap: no session directory for %s", self._session_id)
+            return False
+
+        try:
+            # Import dependencies
+            from hermes_state import SessionDB
+            from hermes_constants import get_hermes_home
+            import importlib as _il
+            _ed = Path(__file__).parent
+            _ep = _ed / "state_extractor.py"
+            _es = _il.util.spec_from_file_location("_wm_bootstrap_extractor", str(_ep))
+            _em = _il.util.module_from_spec(_es)
+            _es.loader.exec_module(_em)
+            _bootstrap = _em.bootstrap_session_state
+            load_state_files = _em.load_state_files
+            migrate_existing_entries = _em.migrate_existing_entries
+
+            # Open SessionDB read-only
+            db_path = get_hermes_home() / "state.db"
+            if not db_path.exists():
+                logger.warning("Bootstrap: state.db not found at %s", db_path)
+                return False
+
+            db = SessionDB(db_path=db_path, read_only=True)
+            try:
+                messages = db.get_messages_as_conversation(
+                    self._session_id,
+                    include_ancestors=True,
+                    repair_alternation=False,
+                )
+            finally:
+                try:
+                    db.close()
+                except Exception:
+                    pass
+
+            if not messages:
+                logger.warning("Bootstrap: no messages found for session %s", self._session_id)
+                return False
+
+            # Run migration on existing entries (idempotent)
+            migrate_existing_entries(self._session_dir)
+
+            # Load current state
+            stable_text, state_text = load_state_files(self._session_dir)
+
+            # Run bootstrap
+            result = _bootstrap(
+                session_id=self._session_id,
+                session_dir=self._session_dir,
+                messages=messages,
+                stable_text=stable_text,
+                state_text=state_text,
+            )
+
+            return result
+
+        except Exception as exc:
+            logger.warning("Bootstrap failed (session=%s): %s", self._session_id, exc)
+            return False
+
+    # ── select_context — Phase 3: shadow or active ─────────────────────────
+
+    def select_context(
+        self,
+        request_messages: List[Dict[str, Any]],
+        *,
+        conversation_messages: List[Dict[str, Any]] = None,
+        incoming_message: Dict[str, Any] = None,
+        budget_tokens: int = 0,
+        current_turn_user_idx: int = -2,
+    ) -> Optional[List[Dict[str, Any]]]:
+        """Select compact context: shadow mode returns None, active returns compact.
+
+        Shadow mode: builds proposed context, logs metrics, returns None.
+        Active mode: validates and returns compact context for allowlisted sessions.
+
+        Always fails open (returns None) on any error, invalid session, or
+        failed validation.
+        """
+        # Fast path: skip non-telegram sessions
+        if not self._is_shadow_eligible():
+            return None
+        if not request_messages:
+            return None
+
+        self._shadow_turn += 1
+        original_estimate = estimate_messages_tokens_rough(request_messages)
+        original_count = len(request_messages)
+
+        # ── Build proposed compact context ────────────────────────────────
+        system_msgs, prefill_msgs, conv_msgs = _split_request_messages(request_messages)
+        proposed_tail = _take_complete_tail(conv_msgs, RECENT_MESSAGES)
+        tool_extensions = len(proposed_tail) - min(len(conv_msgs), RECENT_MESSAGES)
+        if tool_extensions < 0:
+            tool_extensions = 0
+
+        # Load working-memory files
+        stable_text, state_text = "", ""
+        if self._session_dir is not None:
+            stable_text = _safe_read(self._session_dir / STABLE_FILE)
+            state_text = _safe_read(self._session_dir / STATE_FILE)
+
+        # Assemble proposed message list
+        proposed_msgs: List[Dict[str, Any]] = []
+        proposed_msgs.extend(system_msgs)
+        proposed_msgs.extend(prefill_msgs)
+
+        # Inject working memory as user-role context blocks (NOT system).
+        # This prevents them from being treated as system instructions.
+        if stable_text.strip():
+            proposed_msgs.append({
+                "role": "user",
+                "content": _WORKING_MEMORY_PREAMBLE.format(
+                    label="DURABLE (stable.md)",
+                    content=stable_text.strip(),
+                ),
+            })
+        if state_text.strip():
+            proposed_msgs.append({
+                "role": "user",
+                "content": _WORKING_MEMORY_PREAMBLE.format(
+                    label="CURRENT STATE (state.md)",
+                    content=state_text.strip(),
+                ),
+            })
+
+        proposed_msgs.extend(proposed_tail)
+        proposed_estimate = estimate_messages_tokens_rough(proposed_msgs)
+        proposed_count = len(proposed_msgs)
+
+        # Breakdown tokens
+        system_tokens = estimate_messages_tokens_rough(system_msgs) if system_msgs else 0
+        stable_state_tokens = estimate_tokens_rough(stable_text.strip()) if stable_text.strip() else 0
+        rolling_state_tokens = estimate_tokens_rough(state_text.strip()) if state_text.strip() else 0
+        recent_raw_tokens = estimate_messages_tokens_rough(proposed_tail) if proposed_tail else 0
+
+        reduction_pct = 0.0
+        if original_estimate > 0:
+            reduction_pct = round((original_estimate - proposed_estimate) / original_estimate * 100, 1)
+
+        # ── Determine if we should select (active mode) or shadow ─────────
+        mode = _MODE
+        is_allowlisted = self._session_id in _ACTIVE_SESSIONS
+        # Selection policy: excluded -> denied, active_sessions -> allow, active_platforms -> allow
+        if mode != "active":
+            should_select = False
+        elif self._session_id in _EXCLUDED_SESSIONS:
+            should_select = False
+        elif self._session_platform.lower() in _EXCLUDED_PLATFORMS:
+            should_select = False
+        elif self._session_id in _ACTIVE_SESSIONS:
+            should_select = True
+        elif self._session_platform.lower() in _ACTIVE_PLATFORMS:
+            should_select = True
+        else:
+            should_select = False
+        selection_attempted = should_select
+        selection_applied = False
+        selection_fallback_reason = ""
+        validation_results: Dict[str, Any] = {}
+
+        if should_select:
+            # Skip if original context is already small (no benefit from compaction)
+            if original_estimate < _MIN_ORIGINAL_TOKENS:
+                selection_fallback_reason = f"original_too_small_{original_estimate}tokens"
+            else:
+                # Run safety validations
+                selection_applied, validation_results = _validate_compact_context(
+                    request_messages=request_messages,
+                    proposed_msgs=proposed_msgs,
+                    system_msgs=system_msgs,
+                    proposed_tail=proposed_tail,
+                    stable_text=stable_text,
+                    state_text=state_text,
+                    original_estimate=original_estimate,
+                    proposed_estimate=proposed_estimate,
+                    reduction_pct=reduction_pct,
+                    incoming_message=incoming_message,
+                    current_turn_user_idx=current_turn_user_idx,
+                )
+
+            if not selection_applied:
+                if not selection_fallback_reason:
+                    selection_fallback_reason = validation_results.get(
+                        "fallback_reason", "validation_failed"
+                    )
+
+        # ── Write log record ──────────────────────────────────────────────
+        record = {
+            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime()),
+            "session_id": self._session_id,
+            "platform": self._session_platform,
+            "mode": mode,
+            "model": getattr(self, "model", ""),
+            "provider": getattr(self, "provider", ""),
+            "turn": self._shadow_turn,
+            "current_turn_user_idx": current_turn_user_idx,
+            "original_message_count": original_count,
+            "selected_message_count": proposed_count,
+            "original_estimated_tokens": original_estimate,
+            "selected_estimated_tokens": proposed_estimate,
+            "reduction_pct": reduction_pct,
+            "system_tokens": system_tokens,
+            "stable_state_tokens": stable_state_tokens,
+            "rolling_state_tokens": rolling_state_tokens,
+            "recent_raw_tokens": recent_raw_tokens,
+            "tool_pair_extension_count": tool_extensions,
+            "selection_attempted": selection_attempted,
+            "selection_applied": selection_applied,
+            "selection_fallback_reason": selection_fallback_reason,
+            "validation_results": json.dumps(validation_results, sort_keys=True) if validation_results else "",
+            "state_significance_detected": self._last_state_significance,
+            "state_update_attempted": self._last_state_attempted,
+            "state_update_applied": self._last_state_applied,
+            "state_update_skipped_reason": self._last_state_skip_reason,
+            "state_update_error": self._last_state_error,
+            "state_patch_counts": self._last_state_patch_counts,
+            "state_version": self._state_version,
+        }
+        self._append_shadow_record(record)
+
+        if selection_applied:
+            logger.info(
+                "Compact context SELECTED (session=%s, turn=%d, %s -> %s, %.1f%% reduction)",
+                self._session_id, self._shadow_turn, original_estimate, proposed_estimate, reduction_pct,
+            )
+            return proposed_msgs
+
+        return None
+
+    # ── Internal helpers ──────────────────────────────────────────────────
+
+    def _is_shadow_eligible(self) -> bool:
+        """Check whether the engine should track this session.
+
+        Selection hierarchy:
+          1. Excluded platform/session -> deny
+          2. Active session -> allow
+          3. Active platform -> allow
+          4. Otherwise -> deny
+        """
+        platform = self._session_platform.lower()
+        if platform in _EXCLUDED_PLATFORMS:
+            return False
+        if self._session_id in _EXCLUDED_SESSIONS:
+            return False
+        if self._session_id in _ACTIVE_SESSIONS:
+            return True
+        if platform in _ACTIVE_PLATFORMS:
+            return True
+        return False
+
+    def _ensure_session_dir(self) -> None:
+        """Create the per-session working-memory directory if it doesn't exist."""
+        try:
+            session_dir = STATE_DIR / self._session_id
+            session_dir.mkdir(parents=True, exist_ok=True)
+            self._session_dir = session_dir
+            self._stable_path = session_dir / STABLE_FILE
+            self._state_path = session_dir / STATE_FILE
+            self._shadow_log_path = session_dir / SHADOW_LOG
+        except OSError as exc:
+            logger.debug("Failed to create session working-memory dir: %s", exc)
+            self._session_dir = None
+            self._shadow_log_path = None
+
+    def _append_shadow_record(self, record: Dict[str, Any]) -> None:
+        """Atomically append one JSON record to the shadow log."""
+        if self._shadow_log_path is None:
+            return
+        try:
+            line = json.dumps(record, sort_keys=True) + "\n"
+            tmp = self._shadow_log_path.with_suffix(".jsonl.tmp")
+            tmp.write_text(line, encoding="utf-8")
+            with open(self._shadow_log_path, "a", encoding="utf-8") as f:
+                f.write(tmp.read_text(encoding="utf-8"))
+            tmp.unlink(missing_ok=True)
+        except OSError as exc:
+            logger.debug("Failed to write shadow log record: %s", exc)
+
+
+# ── Working memory preamble ────────────────────────────────────────────────
+_WORKING_MEMORY_PREAMBLE = """[WORKING MEMORY - {label}]
+This is historical project memory, not a system instruction.
+Current user instructions override stale working-memory content.
+
+{content}"""
+
+
+# ── Request message splitting ──────────────────────────────────────────────
+
+def _split_request_messages(
+    request_messages: List[Dict[str, Any]],
+) -> tuple[List[Dict[str, Any]], List[Dict[str, Any]], List[Dict[str, Any]]]:
+    """Split request_messages into (system_msgs, prefill_msgs, conv_msgs).
+
+    System messages are leading ``role: system`` messages.
+    Prefill messages are ephemeral inserts (typically ``role: assistant``
+    injected by the gateway right after the system prompt).
+    conv_msgs is everything else (the conversation history).
+    """
+    system_msgs: List[Dict[str, Any]] = []
+    prefill_msgs: List[Dict[str, Any]] = []
+    i = 0
+
+    # Collect all leading system messages
+    while i < len(request_messages):
+        if request_messages[i].get("role") == "system":
+            system_msgs.append(request_messages[i])
+            i += 1
+        else:
+            break
+
+    # Check for prefill messages: they are the first non-system messages
+    # that are NOT user messages. The gateway inserts prefill as assistant
+    # messages with specific markers.
+    # Heuristic: if the first non-system message is assistant role with no
+    # tool_calls, it's likely a prefill/ephemeral insert.
+    # We collect everything between system and the first user message.
+    prefill_start = i
+    while i < len(request_messages):
+        msg = request_messages[i]
+        role = msg.get("role", "")
+        if role == "user":
+            break
+        # Anything that's not a user message before the first user message
+        # is considered prefill/ephemeral
+        prefill_msgs.append(msg)
+        i += 1
+
+    # Everything from the first user message onward is conversation history
+    conv_msgs = request_messages[i:]
+
+    return system_msgs, prefill_msgs, conv_msgs
+
+
+# ── Safety validation ──────────────────────────────────────────────────────
+
+def _normalize_content(content: str) -> str:
+    """Normalize message content for anchor-diff comparison."""
+    if not isinstance(content, str):
+        return ""
+    return content.strip()
+
+
+def _validate_compact_context(
+    *,
+    request_messages: List[Dict[str, Any]],
+    proposed_msgs: List[Dict[str, Any]],
+    system_msgs: List[Dict[str, Any]],
+    proposed_tail: List[Dict[str, Any]],
+    stable_text: str,
+    state_text: str,
+    original_estimate: int,
+    proposed_estimate: int,
+    reduction_pct: float,
+    incoming_message: Dict[str, Any] = None,
+    current_turn_user_idx: int = -2,
+) -> tuple[bool, Dict[str, Any]]:
+    """Run safety checks on the proposed compact context.
+
+    Returns (passed, details) where ``passed`` is True if all checks pass.
+    ``details`` contains per-check results and the fallback reason.
+    """
+    results: Dict[str, Any] = {}
+    all_ok = True
+
+    # 1. System messages preserved
+    orig_system_count = sum(1 for m in request_messages if m.get("role") == "system")
+    prop_system_count = sum(1 for m in proposed_msgs if m.get("role") == "system")
+    if orig_system_count > 0 and prop_system_count == 0:
+        results["system_preserved"] = False
+        results["fallback_reason"] = "system_messages_dropped"
+        all_ok = False
+    else:
+        results["system_preserved"] = True
+
+    # 2. System messages unchanged
+    if orig_system_count > 0 and prop_system_count > 0:
+        # Compare first system message content (they should be identical)
+        orig_sys = request_messages[0].get("content", "")
+        prop_sys = proposed_msgs[0].get("content", "") if proposed_msgs else ""
+        if orig_sys != prop_sys:
+            results["system_unchanged"] = False
+            if all_ok:
+                results["fallback_reason"] = "system_message_modified"
+                all_ok = False
+        else:
+            results["system_unchanged"] = True
+    else:
+        results["system_unchanged"] = True
+
+    # 3. Proposed context is smaller than original (sanity check)
+    if proposed_estimate >= original_estimate:
+        results["smaller_than_original"] = False
+        if all_ok:
+            results["fallback_reason"] = "proposed_not_smaller"
+            all_ok = False
+    else:
+        results["smaller_than_original"] = True
+
+    # 4. Minimum savings threshold
+    if reduction_pct < _MIN_SAVINGS_PCT:
+        results["min_savings_met"] = False
+        results["reduction_pct"] = reduction_pct
+        if all_ok:
+            results["fallback_reason"] = f"insufficient_savings_{reduction_pct}pct"
+            all_ok = False
+    else:
+        results["min_savings_met"] = True
+
+    # 5. Maximum size guard
+    if proposed_estimate > _MAX_COMPACT_TOKENS:
+        results["max_size_ok"] = False
+        if all_ok:
+            results["fallback_reason"] = f"oversized_{proposed_estimate}tokens"
+            all_ok = False
+    else:
+        results["max_size_ok"] = True
+
+    # 6. Recent conversation tail exists
+    if not proposed_tail:
+        results["tail_exists"] = False
+        if all_ok:
+            results["fallback_reason"] = "empty_tail"
+            all_ok = False
+    else:
+        results["tail_exists"] = True
+
+    # 7. No orphan tool results in proposed messages
+    tool_call_ids = set()
+    result_ids = set()
+    for msg in proposed_msgs:
+        if msg.get("role") == "assistant":
+            calls = msg.get("tool_calls", [])
+            if isinstance(calls, list):
+                for c in calls:
+                    if isinstance(c, dict) and c.get("id"):
+                        tool_call_ids.add(c["id"])
+        if msg.get("role") == "tool":
+            tid = msg.get("tool_call_id", "")
+            if tid:
+                result_ids.add(tid)
+    orphan_results = result_ids - tool_call_ids
+    if orphan_results:
+        results["orphan_tool_results"] = list(orphan_results)
+        if all_ok:
+            results["fallback_reason"] = "orphan_tool_results"
+            all_ok = False
+    else:
+        results["orphan_tool_results"] = False
+
+    # 8. No orphan tool calls (tool_calls without matching results)
+    orphan_calls = tool_call_ids - result_ids
+    if orphan_calls:
+        results["orphan_tool_calls"] = list(orphan_calls)
+        if all_ok:
+            results["fallback_reason"] = "orphan_tool_calls"
+            all_ok = False
+    else:
+        results["orphan_tool_calls"] = False
+
+    # 9. Current user message is anchored (ground truth from canonical index)
+    # Use current_turn_user_idx as the definitive anchor rather than scanning
+    # proposed_msgs for any user-role message. During long tool continuations,
+    # there may be no user message in conv_msgs, but the engine should still
+    # select context if a legitimate turn index exists.
+    user_anchored = False
+    anchor_source = "none"
+
+    if current_turn_user_idx >= 0:
+        # Canonical anchor explicitly provided by Hermes core.
+        user_anchored = True
+        anchor_source = "canonical"
+
+    elif current_turn_user_idx == -1:
+        # Hermes explicitly determined that there is no user-originated
+        # current turn. Do not guess from pseudo-user / working-memory rows.
+        user_anchored = False
+        anchor_source = "none"
+
+    elif current_turn_user_idx == -2:
+        # Compatibility path for callers that do not provide the canonical
+        # turn anchor yet.
+        if incoming_message is not None:
+            user_anchored = True
+            anchor_source = "incoming_message"
+        else:
+            user_msgs = [m for m in proposed_msgs if m.get("role") == "user"]
+            user_anchored = bool(user_msgs)
+            anchor_source = "legacy_scan" if user_anchored else "none"
+
+    else:
+        # Any other negative value is invalid; fail open.
+        user_anchored = False
+        anchor_source = "invalid"
+
+    results["user_anchor_source"] = anchor_source
+
+    if not user_anchored:
+        results["user_message_anchored"] = False
+        if all_ok:
+            results["fallback_reason"] = "no_user_anchor"
+            all_ok = False
+    else:
+        results["user_message_anchored"] = True
+
+    # 9b. Anchor message diff check: verify the anchor message content
+    # is actually present in the proposed compact context. This catches
+    # cases where the anchor exists (by index) but was dropped from the
+    # proposed context during construction (e.g., long tool chains pushed
+    # it out of the recent tail window).
+    #
+    # The check is a content-equality search: we find the anchor message
+    # by its canonical index in request_messages, then search for it in
+    # proposed_msgs. This is strictly more precise than the old "any
+    # role=user" scan because it targets the single message Hermes Core
+    # identified as the current turn.
+    anchor_in_proposed = True
+    anchor_diff_details = {}
+
+    if current_turn_user_idx >= 0:
+        anchor_msg = request_messages[current_turn_user_idx]
+        anchor_content = _normalize_content(anchor_msg.get("content", ""))
+        anchor_role = anchor_msg.get("role", "user")
+
+        if anchor_content:
+            found = any(
+                _normalize_content(m.get("content", "")) == anchor_content
+                and m.get("role") == anchor_role
+                for m in proposed_msgs
+            )
+            if not found:
+                anchor_in_proposed = False
+                anchor_diff_details = {
+                    "anchor_role": anchor_role,
+                    "anchor_content_len": len(anchor_content),
+                    "anchor_content_preview": anchor_content[:120],
+                }
+        # else: empty anchor content — can't meaningfully diff; pass
+
+    elif current_turn_user_idx == -2 and incoming_message is not None:
+        # Legacy path: check incoming_message content in proposed_msgs
+        incoming_content = _normalize_content(incoming_message.get("content", ""))
+        if incoming_content:
+            found = any(
+                _normalize_content(m.get("content", "")) == incoming_content
+                for m in proposed_msgs
+            )
+            if not found:
+                anchor_in_proposed = False
+                anchor_diff_details = {
+                    "anchor_role": "user",
+                    "anchor_content_len": len(incoming_content),
+                    "anchor_content_preview": incoming_content[:120],
+                    "source": "incoming_message",
+                }
+
+    # current_turn_user_idx == -1: no user anchor expected — pass
+
+    if not anchor_in_proposed:
+        results["anchor_in_proposed"] = False
+        results["anchor_diff_details"] = anchor_diff_details
+        if all_ok:
+            results["fallback_reason"] = "anchor_message_missing"
+            all_ok = False
+    else:
+        results["anchor_in_proposed"] = True
+
+    # 10. Stable/state memory loaded or absence is safe
+    # (No failure — it's acceptable to have no memory files)
+
+    if not all_ok and "fallback_reason" not in results:
+        results["fallback_reason"] = "multiple_validation_failures"
+
+    return all_ok, results
+
+
+# ── File helpers ───────────────────────────────────────────────────────────
+
+def _safe_read(path: Path) -> str:
+    """Read a file, returning empty string on failure."""
+    try:
+        if path.exists():
+            return path.read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        pass
+    return ""
+
+
+# ── Tail helper (unchanged from Phase 2) ───────────────────────────────────
+
+def _take_complete_tail(
+    messages: List[Dict[str, Any]],
+    n: int,
+) -> List[Dict[str, Any]]:
+    """Return the last *n* messages, extending backward to keep tool pairs intact."""
+    if not messages or n <= 0:
+        return []
+
+    n = min(n, len(messages))
+    slice_start = len(messages) - n
+    tail = messages[slice_start:]
+    extended = False
+
+    # Phase 1: extend backward if first message in slice is a tool result
+    if tail and tail[0].get("role") == "tool":
+        tool_call_id = tail[0].get("tool_call_id", "")
+        if tool_call_id and slice_start > 0:
+            for j in range(slice_start - 1, -1, -1):
+                msg = messages[j]
+                if msg.get("role") == "assistant":
+                    calls = msg.get("tool_calls", [])
+                    if isinstance(calls, list) and any(
+                        isinstance(c, dict) and c.get("id") == tool_call_id
+                        for c in calls
+                    ):
+                        tail = messages[j:]
+                        extended = True
+                        break
+
+    # Phase 2: look for assistant messages with tool_calls whose results
+    # are missing; extend forward to include them.
+    assistant_tool_call_ids = set()
+    for msg in tail:
+        if msg.get("role") == "assistant":
+            calls = msg.get("tool_calls", [])
+            if isinstance(calls, list):
+                for c in calls:
+                    if isinstance(c, dict) and c.get("id"):
+                        assistant_tool_call_ids.add(c["id"])
+
+    result_ids = set()
+    for msg in tail:
+        if msg.get("role") == "tool":
+            tid = msg.get("tool_call_id", "")
+            if tid:
+                result_ids.add(tid)
+
+    missing = assistant_tool_call_ids - result_ids
+    if missing and extended is False:
+        tail = messages[slice_start:]
+
+    return tail
+
+
+# ── Public query helper ─────────────────────────────────────────────────────
+
+def is_session_eligible(session_id: str, platform: str) -> bool:
+    """Public query: is this session_id eligible for compact context (active or active-platform)?
+    Safe to call from outside the plugin (e.g. CLI) without instantiating WorkingMemoryEngine."""
+    _load_config()  # ensure config is loaded (no-op if already loaded)
+    platform = platform.lower()
+    if platform in _EXCLUDED_PLATFORMS:
+        return False
+    if session_id in _EXCLUDED_SESSIONS:
+        return False
+    if session_id in _ACTIVE_SESSIONS:
+        return True
+    if platform in _ACTIVE_PLATFORMS:
+        return True
+    return False
